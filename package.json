{
  "name": "dob-innovation-learning-hub",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "NODE_ENV=development next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "db:init": "bash scripts/dev-db.sh init",
    "db:start": "bash scripts/dev-db.sh start",
    "db:stop": "bash scripts/dev-db.sh stop",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:seed": "tsx prisma/seed.ts",
    "db:reset": "prisma db push --force-reset && tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "live:dev": "livekit-server --dev --bind 127.0.0.1",
    "postinstall": "prisma generate",
    "create-admin": "tsx scripts/create-admin.ts",
    "backup": "tsx scripts/backup.ts",
    "cron:reminders": "tsx --conditions=react-server scripts/reminders.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.135.0",
    "@aws-sdk/client-s3": "^3.1157.0",
    "@aws-sdk/s3-request-presigner": "^3.1157.0",
    "@livekit/components-react": "^2.9.24",
    "@livekit/components-styles": "^1.2.0",
    "@prisma/client": "6.19",
    "bcryptjs": "^3.0.3",
    "clsx": "^2.1.1",
    "jose": "^5.10.0",
    "livekit-client": "^2.23.0",
    "livekit-server-sdk": "^2.19.1",
    "lucide-react": "^0.577.0",
    "motion": "^12.43.0",
    "next": "15.5",
    "react": "19.1",
    "react-dom": "19.1",
    "recharts": "^2.15.4",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.7.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^20.19.43",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "15.5",
    "postcss": "^8.5.30",
    "prisma": "6.19",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
}
