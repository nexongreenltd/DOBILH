# Copy to .env and fill in real values. On Railway, set these as service variables instead.
DATABASE_URL="postgresql://dob@localhost:5433/dob_lms?schema=public"
# 32+ random characters, e.g. `openssl rand -hex 32`
AUTH_SECRET=""
# Public URL of the site (links in emails, certificates)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Payments: "sandbox" = simulated gateway (development only — anyone could "pay");
# "manual" = staff confirm payments in Admin → Payments (production default until PayPlus is connected).
PAYMENT_MODE=""
# HMAC secret for the sandbox payment gateway callback
PAYMENT_SANDBOX_SECRET=""

# Optional: enables generative answers in the AI assistant (falls back to curated knowledge if unset)
ANTHROPIC_API_KEY=""
# Optional: claude-opus-5-5 (default) or claude-sonnet-5-5 (about half the cost)
AI_MODEL=""

# File storage. Local disk by default; set the R2_* values to use Cloudflare R2 (production).
# STORAGE_DIR is also scratch space for live-class recordings (Railway: a volume at /data → /data/storage).
STORAGE_DIR=""
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET=""
# Number of nightly database backups to keep in R2 (npm run backup)
BACKUP_KEEP="14"

# Email (Resend). Without a key, emails are printed to the server log instead.
RESEND_API_KEY=""
EMAIL_FROM="DoB Innovation & Learning Hub <no-reply@example.org>"

# DoB Live — in-app live classes (LiveKit). Local dev: `npm run live:dev` uses devkey / secret.
# Production: LiveKit Cloud project credentials (wss://<project>.livekit.cloud).
LIVEKIT_URL="ws://localhost:7880"
LIVEKIT_API_KEY="devkey"
LIVEKIT_API_SECRET="secret"
# Optional: path to ffmpeg used to transcode class recordings to MP4 (default: ffmpeg on PATH)
FFMPEG_PATH=""
