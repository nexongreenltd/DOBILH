# Copy to .env and fill in real values.
DATABASE_URL="postgresql://dob@localhost:5433/dob_lms?schema=public"
# 32+ random characters, e.g. `openssl rand -hex 32`
AUTH_SECRET=""
# HMAC secret for the sandbox payment gateway callback
PAYMENT_SANDBOX_SECRET=""
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# Optional: enables generative answers in the AI assistant (falls back to curated knowledge if unset)
ANTHROPIC_API_KEY=""
# Optional: where uploaded files are stored (default storage/uploads)
STORAGE_DIR=""
